<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Discord Bot Dashboard</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <div class="dashboard-layout">
      <aside class="sidebar">
        <div class="brand">
          <h2>SparkyDevelopment</h2>
        </div>

        <nav class="side-nav" aria-label="Sidebar-Navigation">
          <button class="nav-tab active" type="button" data-tab="overview"><span>Übersicht</span><small>Live-Status</small></button>
          <button class="nav-tab" type="button" data-tab="commands"><span>Commands</span><small>Bot-Befehle</small></button>
          <button class="nav-tab" type="button" data-tab="server"><span>Server</span><small>Gemeinschaften</small></button>
          <button class="nav-tab" type="button" data-tab="voice"><span>Voice</span><small>Join/Leave</small></button>
          <button class="nav-tab" type="button" data-tab="roles"><span>Rollen</span><small>Verwalten</small></button>
          <button class="nav-tab" type="button" data-tab="settings"><span>Einstellungen</span><small>Verbindung</small></button>
          <button class="nav-tab" type="button" data-tab="users"><span>Benutzer</span><small>Zugriff steuern</small></button>
          <button class="nav-tab" type="button" data-tab="log"><span>Log</span><small>Aktivitäten</small></button>
        </nav>
      </aside>

      <main class="content">
        <div class="tab-panel active" data-panel="overview">
          <h2>Dashboard-Übersicht</h2>
          <div class="stats-grid">
            <div class="stat-card"><h4>Bot-Status</h4><strong><%= botOnline ? 'Online' : 'Offline' %></strong></div>
            <div class="stat-card"><h4>Server</h4><strong><%= guilds.length %></strong></div>
            <div class="stat-card"><h4>Mitglieder</h4><strong><%= totalMembers %></strong></div>
            <div class="stat-card"><h4>Rollen</h4><strong><%= totalRoles %></strong></div>
          </div>

          <div class="section-card">
            <h3>Verbindung</h3>
            <p>Bot: <strong><%= botUsername %></strong></p>
            <p>Bot-Token eingerichtet: <strong><%= tokenConfigured ? 'Ja' : 'Nein' %></strong></p>
          </div>
        </div>

        <div class="tab-panel" data-panel="commands">
          <h3>Bot-Commands</h3>
          <div class="settings-box">
            <form method="POST" action="/send-message" class="inline-form">
              <label for="commandMessage">Nachricht an den Bot senden</label>
              <textarea id="commandMessage" name="message" rows="4" placeholder="Hallo Bot..." required></textarea>
              <button type="submit">Senden</button>
            </form>
          </div>
        </div>

        <div class="tab-panel" data-panel="server">
          <h3>Server</h3>
          <div class="server-list">
            <% if (guilds && guilds.length) { %>
              <% guilds.forEach((guild) => { %>
                <div class="server-item server-card">
                  <div class="server-title"><span class="server-avatar"><%= guild.name.slice(0, 1).toUpperCase() %></span><strong><%= guild.name %></strong></div>
                  <div class="server-metrics"><span><b><%= guild.memberCount %></b> Mitglieder</span><span><b><%= guild.channels.length %></b> Kanäle</span><span><b><%= guild.roleCount %></b> Rollen</span></div>
                </div>
              <% }) %>
            <% } else { %>
              <p>Keine Server gefunden. Der Bot muss auf einem Discord-Server sein.</p>
            <% } %>
          </div>
        </div>

        <div class="tab-panel" data-panel="voice">
          <h3>Voice-Kanal</h3>
          <div class="settings-box voice-box">
            <form method="POST" action="/voice/join" class="role-form">
              <label for="voiceGuildId">Server</label>
              <select id="voiceGuildId" name="guildId" required>
                <option value="">Server auswählen</option>
                <% guilds.forEach((guild) => { %>
                  <option value="<%= guild.id %>"><%= guild.name %></option>
                <% }) %>
              </select>

              <label for="voiceChannelId">Voice-Kanal</label>
              <select id="voiceChannelId" name="channelId" required>
                <option value="">Kanal auswählen</option>
                <% guilds.forEach((guild) => { %>
                  <% guild.voiceChannels.forEach((channel) => { %>
                    <option value="<%= channel.id %>" data-guild="<%= guild.id %>"><%= guild.name %> · <%= channel.name %></option>
                  <% }) %>
                <% }) %>
              </select>

              <button type="submit">Bot in Voice joinen</button>
            </form>

            <form method="POST" action="/voice/leave" style="margin-top: 18px;">
              <button class="secondary" type="submit">Bot aus Voice verlassen</button>
            </form>
          </div>
        </div>

        <div class="tab-panel" data-panel="roles">
          <h3>Rollen verwalten</h3>
          <div class="settings-box">
            <form method="POST" action="/edit-role" class="role-form">
              <label for="roleGuildId">Server</label>
              <select id="roleGuildId" name="guildId" required>
                <option value="">Server auswählen</option>
                <% guilds.forEach((guild) => { %>
                  <option value="<%= guild.id %>"><%= guild.name %></option>
                <% }) %>
              </select>

              <label for="roleName">Rollenname</label>
              <input id="roleName" name="roleName" type="text" placeholder="z. B. Support" required />

              <label for="roleColor">Farbe</label>
              <input id="roleColor" name="roleColor" type="color" value="#7c3aed" />

              <button type="submit">Rolle erstellen</button>
            </form>
          </div>
        </div>

        <div class="tab-panel" data-panel="settings">
          <h3>Einstellungen</h3>
          <div class="settings-box">
            <form method="POST" action="/setup" class="inline-form">
              <label for="token">Bot Token</label>
              <input id="token" name="token" type="password" placeholder="Bot Token" />
              <button type="submit">Token speichern</button>
            </form>
          </div>
        </div>

        <div class="tab-panel" data-panel="users">
          <h3>Benutzer</h3>
          <div class="settings-box">
            <p>Auf dieser Seite kannst du Zugriffsrechte verwalten.</p>
          </div>
        </div>

        <div class="tab-panel" data-panel="log">
          <h3>Aktivitäts-Log</h3>
          <div class="settings-box">
            <% if (logs && logs.length) { %>
              <div class="log-table-wrap">
                <table class="log-table">
                  <thead>
                    <tr>
                      <th>Zeit</th>
                      <th>Typ</th>
                      <th>Nachricht</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% logs.forEach((log) => { %>
                      <tr>
                        <td><%= new Date(log.timestamp).toLocaleString('de-DE') %></td>
                        <td><span class="log-tag <%= log.type %>"><%= log.type %></span></td>
                        <td><%= log.message %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <p>Noch keine Aktivitäten protokolliert.</p>
            <% } %>
          </div>
        </div>
      </main>
    </div>

    <script>
      document.querySelectorAll('.nav-tab').forEach((tab) => {
        tab.addEventListener('click', () => {
          document.querySelectorAll('.nav-tab').forEach((btn) => btn.classList.remove('active'));
          document.querySelectorAll('.tab-panel').forEach((panel) => panel.classList.remove('active'));
          tab.classList.add('active');
          document.querySelector('[data-panel="' + tab.dataset.tab + '"]').classList.add('active');
        });
      });
    </script>
  </body>
</html>
