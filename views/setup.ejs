<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bot einrichten</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body class="setup-page">
    <div class="card setup-card">
      <h1>Discord Bot Dashboard</h1>
      <p>Bitte trage deinen Discord Bot-Token ein, damit die Verbindung hergestellt werden kann.</p>

      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>

      <form method="POST" action="/setup" class="login-form">
        <label for="token">Bot Token</label>
        <input id="token" name="token" type="password" placeholder="Discord Bot Token" required />

        <button type="submit">Bot speichern und verbinden</button>
      </form>
    </div>
  </body>
</html>
